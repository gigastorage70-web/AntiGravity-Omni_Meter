# =====================================================================
# ANTIGRAVITY OMNI-METER PRODUCTION ENVIRONMENT CONFIGURATION
# =====================================================================

# 1. Supabase PostgreSQL & Auth Configuration
# Obtain from: https://supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_4xREq4RMMLI_T7vJtyixuQ_MSdyS5CC
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key

# 2. Cloudflare R2 Storage Configuration (Can be configured later)
# Obtain from: Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=antigravity-vault
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# 3. Application Port & Environment
NODE_ENV=production
PORT=3000
